{
  "multipart": [
    {
      "apply": {
        "model": "tfcpp:block/pipe/wrought_iron_center"
      }
    },
    {
      "apply": {
        "model": "tfcpp:block/pipe/wrought_iron_arm"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "tfcpp:block/pipe/wrought_iron_arm",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "tfcpp:block/pipe/wrought_iron_arm",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "tfcpp:block/pipe/wrought_iron_arm",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "tfcpp:block/pipe/wrought_iron_arm",
        "x": 270
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "tfcpp:block/pipe/wrought_iron_arm",
        "x": 90
      },
      "when": {
        "down": "true"
      }
    }
  ]
}