  "icon": "minecraft:charcoal",
  "name": "Charcoal Pit",
  "pages": [
    {
      "type": "patchouli:text",
      "text": "The $(thing)Charcoal Pit$() makes $(thing)Charcoal$() from logs. Logs are stacked in $(thing)Log Piles$(): $(item)$(k:key.use)$() with $(item)$(k:key.sneak)$() and a log in hand places a pile. More logs go in with $(item)$(k:key.use)$() holding a log, or into the pile's window opened with any other item."
    },
    {
      "type": "patchouli:multiblock",
      "enable_visualize": false,
      "multiblock": {
        "mapping": {
          "X": "tfc:log_pile"
        },
        "pattern": [
          [
            "X"
          ],
          [
            "0"
          ]
        ]
      },
      "name": "The Log Pile",
      "text": "A log pile needs a solid block to stand on, and burns easily."
    },
    {
      "type": "patchouli:text",
      "text": "Close the piles in on every side with solid blocks that do not burn: earth is usual. Light one pile and cover it. Smoke rising from the heap shows that it caught. The charcoal you get follows the logs inside."
    },
    {
      "type": "patchouli:multiblock",
      "enable_visualize": false,
      "multiblock": {
        "mapping": {
          "0": "tfc:log_pile",
          "D": "tfc:dirt/aridisol"
        },
        "pattern": [
