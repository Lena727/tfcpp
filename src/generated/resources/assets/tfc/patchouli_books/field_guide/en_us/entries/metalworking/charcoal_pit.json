            "DDD",
            "DDD"
          ],
          [
            "DDD",
            "D0D",
            "DDD"
          ],
          [
            "DDD",
            "DDD",
            "DDD"
          ]
        ]
      },
      "name": "A Pit",
      "text": "One possible pit: earth all round the pile."
    },
    {
      "type": "patchouli:text",
      "anchor": "charcoal_pile",
      "text": "When the pit has burnt out and stopped smoking, $(thing)Charcoal Piles$() remain, up to 8 layers each. Dig them with a shovel for charcoal. A pile can be added to or placed with $(item)$(k:key.use)$()."
    },
